            {
              "$ref": "#/$defs/T49"
            },
            {
              "$ref": "#/$defs/T50"
            }
          ],
          "description": "Boundary-driven spaces keep rings and dimensions as a validated, generated cache.\nAbsent is an independent outline, preserving existing/imported projects without guessing."
        },
        "slope": {
          "$ref": "#/$defs/T52",
          "description": "Makes this area a sloped plane rather than a flat plate; see Slope."
        },
        "ceilingHeight": {
          "type": "number",
          "description": "Clear ceiling height above this floor's datum; omitted uses the storey height.\nA room spanning storeys uses this with holes in the plates above it."
        },
        "water": {
          "$ref": "#/$defs/T53",
          "description": "A basin below this area's walking surface, filled with clear water."
        },
        "slide": {
          "$ref": "#/$defs/T54",
          "description": "Open water-slide centreline, in metres relative to the object's position and rotation.\nThe third coordinate is height above its floor."
        },
        "baseHeight": {
          "type": "number",
          "description": "Bottom of a raised fixture, metres above the floor surface (e.g. a doorway lintel)."
        },
        "width": {
          "type": "number"
        },
        "depth": {
          "type": "number"
        },
        "parentId": {
          "type": "string"
        },
        "barrierId": {
          "type": "string"
        },
        "offset": {
          "type": "number"
        },
        "doorHinge": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "description": "Door hinge at the wall start (left, default) or end (right)."
        },
        "doorType": {
          "type": "string",
          "enum": [
            "hinged",
            "sliding",
            "double"
          ],
          "description": "Door mechanism. Omitted means a conventional single hinged leaf."
        },
        "doorSwing": {
          "type": "number",
          "enum": [
            1,
            -1
          ],
          "description": "Door opens to the left (+1, default) or right (-1) of the directed wall."
        },
        "feedId": {
          "type": "string"
        },
        "servedFloorIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stairModel": {
          "type": "string",
          "enum": [
            "straight",
            "switchback",
            "dogleg",
            "spiral",
            "escalator"
          ],
          "description": "Stairs only: which geometry this climb has.\n\n`straight` is one run. `switchback` turns back on itself around a half-landing — the half-turn\nstair that fits a storey into a short core box, and what most building stairs actually are.\n`dogleg` turns a quarter at its landing, for a stair in the corner of a plan. `spiral` winds\naround a pole and can land on every level it passes. `escalator` is a machine: a fixed 30° pitch\nand a flat comb plate at each end.\n\nAll of them connect the same floors and route identically, which is why this is one field rather\nthan five kinds — the difference is what it looks like and how much run it needs. Absent picks\nthe shape that fits: a straight run where the footprint allows a civil pitch, a switchback where\nit does not, since a plan that gives a 4.5 m box to a 4.4 m storey means a stair that turns, not\na ladder."
        },
        "wellGroup": {
          "type": "string",
          "description": "Stairs with the same group on a level share one rectangular floor/ceiling opening."
        },
        "travel": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ],
          "description": "Escalators only: which way the machine carries you.\n\nIt is a property of the machine, not of the drawing and not of its name: an escalator runs one\nway, a bank of them runs alternate ways, and which way this one runs is the first thing anyone\nasks of it. The same vocabulary as `Zone.connects`, so the described layer and the object never\nneed translating between them. Absent means up, which is what a lone escalator nearly always\ndoes. A stair that is not an escalator ignores it — a stair carries you both ways.\n\nAn imported escalator arrives once per storey it is drawn on; the twin standing lowest is the\none the model draws and routes from, so that is the one to author."
        },
        "doorSides": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "front",
              "back"
            ]
          },
          "description": "Elevators only: which faces of the car open, relative to the object's own rotation. A through-car\nopens front and back; a corner lobby car opens front and one side. Absent means the front alone,\nwhich is what almost every lift does. Which FLOORS it opens on is `servedFloorIds` — a level the\nshaft passes without serving has no doors on any side."
        },
        "coverageAngle": {
          "type": "number"
        },
        "coverageRange": {
          "type": "number"
        },
        "watchedIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Camera: ids of the doors, rooms and elevators this camera observes (event footage lookup)."
        },
        "model": {
          "type": "string",
          "enum": [
            "bed",
            "sofa",
            "dining",
            "cabinet",
            "counter",
            "toilet",
            "basin",
            "shower",
            "sauna",
            "tree",
            "shrub",
            "lamp",
            "car",
            "chimney",
            "vent",
            "post"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
