    "T32": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/T19"
        },
        "openingId": {
          "type": "string",
          "description": "The opening object (door/gate/turnstile) crossed here; absent for a virtual portal — an open\nboundary between two spaces with no physical separator, which malls and open-plan floors need.\nKept as a reference rather than folded in, so two portals can be known to share one door leaf."
        },
        "a": {
          "type": "string",
          "description": "The two sides. Order is storage, not meaning — ask `entryInto` rather than reading it."
        },
        "b": {
          "type": "string"
        },
        "passage": {
          "type": "string",
          "enum": [
            "both",
            "a-to-b",
            "b-to-a",
            "none"
          ],
          "description": "Which way passage is possible at all. Default 'both'."
        },
        "attests": {
          "type": "string",
          "enum": [
            "none",
            "confirmed",
            "assumed"
          ],
          "description": "How far a crossing here can be trusted to have actually happened.\n'confirmed' — a sensor saw it (a door monitor opening and closing).\n'assumed'   — inferred from a grant; nobody watched. The default for a plain door.\n'none'      — the crossing is a *request*, not an event: a lift floor button, where the\n              passenger may go anywhere. Anything counting crossings must ignore these."
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
