{
  "name": "kerros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "vite-node server/index.ts",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:raster": "KERROS_NATIVE_ANALYSIS_TESTS=1 vitest run --config server/vitest.config.ts scripts/plan-import/raster.test.ts",
    "test:raster:docker": "sh scripts/plan-import/test-raster.sh",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:geometry": "vitest run src/model/authoring.fuzz.test.ts src/model/authoring.test.ts src/model/boundaries.test.ts",
    "budget": "node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test",
    "test:production": "npm run build && KERROS_E2E_PRODUCTION=1 playwright test tests/production.spec.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "capture:media": "node scripts/capture-media.mjs",
    "test:media": "node --test scripts/media-capture.test.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build:site": "vite build --base=./ && vitepress build docs && cp -R docs/.vitepress/dist/. dist/",
    "build:lib": "npm run build --workspaces",
    "generate:ai-tools": "node scripts/plan-import/modelSchema.mjs",
    "check:ai-tools": "node scripts/plan-import/modelSchema.mjs --check"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.0",
    "pdfjs-dist": "^6.3.289",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@biomejs/biome": "^2.5.12",
    "@mapbox/vector-tile": "^3.0.0",
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "markdown-it-mathjax3": "^4.3.2",
    "pbf": "^5.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
