# Copy this template to .env.local and fill in only the services you use.
# MML vector maps: https://www.maanmittauslaitos.fi/rajapinnat/api-avaimen-ohje
# VITE_ values are public in the client bundle. See docs/guide/mml-maps.md.
VITE_MML_API_KEY=

# Claude AI import (backend and CLI): https://platform.claude.com/settings/keys
# Keep this secret; never give it a VITE_ prefix. See docs/guide/ai-import.md.
ANTHROPIC_API_KEY=

# Optional model override; defaults to claude-opus-4-8.
# ANTHROPIC_MODEL=claude-opus-4-8

# Native (non-Docker) development: enable the editor's optional AI import tab.
# Docker Compose sets this automatically and proxies the backend.
# VITE_AI_IMPORT_URL=/api/ai-import
