{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded",
      "bracketSpacing": true
    }
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false },
  "files": {
    "includes": [
      "src/**/*.{ts,tsx,css}",
      "app/**/*.{ts,tsx,css}",
      "tests/**/*.ts",
      "!**/dist/**",
      "!**/node_modules/**"
    ]
  }
}
