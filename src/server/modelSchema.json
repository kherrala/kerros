    "T30": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/T19"
        },
        "purpose": {
          "type": "string",
          "description": "Host vocabulary ('security', 'evacuation', 'hvac', …). The core never interprets it."
        },
        "connects": {
          "type": "string",
          "enum": [
            "all",
            "adjacent",
            "up",
            "down"
          ],
          "description": "How the spaces within this zone reach each other, when they are not joined by portals.\n'all'      — every space mutually reachable: a lift serving all of its landings.\n'adjacent' — reachable in elevation order, both ways: a stair, passing each level in turn.\n'up'/'down'— adjacent but one-way: an escalator, which carries you in a single direction.\nomitted    — no implied connectivity; the zone is a grouping only."
        }
      },
      "required": [],
      "additionalProperties": false
    },
