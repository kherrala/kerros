{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "../../src",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "../../src/viewer/index.ts",
    "../../src/viewer/host.ts"
  ],
  "exclude": [
    "../../src/**/*.test.ts",
    "../../src/main.tsx",
    "../../src/viewer/main.tsx"
  ]
}